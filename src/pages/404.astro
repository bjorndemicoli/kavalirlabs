---
// Shown by the web host for addresses that do not exist. Kept out of search results.
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | Kavalir Labs"
  description="The page you are looking for does not exist."
  noindex
>
  <section aria-labelledby="not-found-heading" class="flex min-h-svh items-center bg-navy-900 text-offwhite">
    <div class="mx-auto w-full max-w-3xl px-6 pb-24 pt-36 text-center">
      <h1
        id="not-found-heading"
        class="font-display text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl"
      >
        Page <span class="text-teal-400">not found</span>
      </h1>
      <p class="mx-auto mt-6 max-w-md text-lg leading-relaxed text-slate-blue-300">
        The page you are looking for does not exist or has moved.
      </p>
      <div class="mt-10">
        <a
          href="/"
          class="inline-block rounded-full bg-teal-400 px-8 py-4 text-base font-semibold text-navy-950 transition hover:bg-teal-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-300"
        >
          Back to the home page
        </a>
      </div>
    </div>
  </section>
</Layout>
