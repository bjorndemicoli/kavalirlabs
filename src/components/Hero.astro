---
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative isolate flex min-h-svh items-center overflow-hidden bg-navy-900"
>
  <!-- Decorative background: faint grid plus a soft teal glow -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute inset-0 opacity-[0.07] [background-image:linear-gradient(to_right,var(--color-slate-blue-300)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-slate-blue-300)_1px,transparent_1px)] [background-size:64px_64px] [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"
    >
    </div>
    <div
      class="absolute left-1/2 top-[-20%] h-[640px] w-[900px] max-w-none -translate-x-1/2 rounded-full bg-teal-500/15 blur-[140px]"
    >
    </div>
    <div
      class="absolute bottom-[-30%] left-[10%] h-[480px] w-[640px] rounded-full bg-slate-blue-500/20 blur-[140px]"
    >
    </div>
  </div>

  <div class="mx-auto w-full max-w-6xl px-6 pb-24 pt-36 text-center">
    <h1
      id="hero-heading"
      class="mx-auto max-w-5xl animate-fade-up text-balance font-display text-5xl font-semibold leading-[1.05] tracking-tight text-offwhite sm:text-6xl xl:text-7xl"
    >
      <!-- Each sentence starts on its own line; the space keeps the text readable as one string. -->
      Less manual work.{' '}
      <span class="block text-teal-400">More time for your business.</span>
    </h1>

    <p
      class="mx-auto mt-8 max-w-2xl animate-fade-up text-pretty text-lg leading-relaxed text-slate-blue-300 [animation-delay:120ms] sm:text-xl"
    >
      We help businesses save time and work more efficiently by automating everyday tasks with AI.
    </p>

    <div
      class="mt-12 flex animate-fade-up flex-col items-center justify-center gap-4 [animation-delay:240ms] sm:flex-row"
    >
      <a
        href="#contact"
        class="w-full rounded-full bg-teal-400 px-8 py-4 text-base font-semibold text-navy-950 transition hover:bg-teal-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-300 sm:w-auto"
      >
        Book a Free Consultation
      </a>
      <a
        href="#services"
        class="w-full rounded-full border border-slate-blue-400/80 px-8 py-4 text-base font-semibold text-offwhite transition-colors hover:border-teal-400 hover:text-teal-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-400 sm:w-auto"
      >
        Explore Our Services
      </a>
    </div>
  </div>
</section>
