---
// Section 2: Problems We Solve
// The section heading, label and card titles are the client's wording, and the
// descriptions are the set the client chose. Do not reword without asking.
const problems = [
  {
    icon: 'documents',
    title: 'Too much repetitive administrative work',
    description:
      'Invoices, receipts and reports take up hours every week. Those hours come out of planning, selling and looking after customers.',
  },
  {
    icon: 'clock',
    title: 'Slow customer responses and missed opportunities',
    description:
      'Questions and quote requests sit unanswered while everyone is busy. Some of the people asking will not wait long.',
  },
  {
    icon: 'blocks',
    title: 'Disconnected tools and inefficient workflows',
    description:
      'The same details get copied from email to spreadsheet to calendar. Each copy is another chance for a mistake.',
  },
];
---

<section id="problems" aria-labelledby="problems-heading" class="bg-offwhite text-navy-900">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <div data-reveal>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-700">Problems We Solve</p>
      <h2
        id="problems-heading"
        class="mt-5 max-w-4xl text-balance font-display text-4xl font-semibold leading-[1.1] tracking-tight text-navy-900 sm:text-5xl lg:text-6xl"
      >
        Your team should focus on <span class="text-teal-700">growing your business</span>, not
        repetitive tasks.
      </h2>
    </div>

    {/*
      Cards: stacked on phones, icon-left rows on tablets, three columns from 1024px.
      (Three columns below 1024px squeezes the titles onto four lines.)
    */}
    <ul role="list" class="mt-16 grid gap-6 lg:mt-20 lg:grid-cols-3 lg:gap-8">
      {
        problems.map((problem, index) => (
          <li
            data-reveal
            style={`--reveal-delay: ${index * 100}ms`}
            class="flex flex-col gap-6 rounded-2xl border border-navy-900/10 bg-white p-8 sm:flex-row sm:gap-8 lg:flex-col lg:gap-6 xl:p-10"
          >
            <div
              aria-hidden="true"
              class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-teal-500/10 text-teal-700"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-7 w-7"
              >
                {problem.icon === 'documents' && (
                  <>
                    <rect x="4.75" y="6.75" width="11" height="13.5" rx="1.75" />
                    <path d="M8.25 3.75h8a3 3 0 0 1 3 3v10" />
                    <path d="M7.75 11h5M7.75 14h5M7.75 17h3" />
                  </>
                )}
                {problem.icon === 'clock' && (
                  <>
                    <circle cx="12" cy="12" r="8.25" />
                    <path d="M12 7.5V12l3 1.75" />
                  </>
                )}
                {problem.icon === 'blocks' && (
                  <>
                    <rect x="3.75" y="3.75" width="7.5" height="7.5" rx="1.75" />
                    <rect x="12.75" y="12.75" width="7.5" height="7.5" rx="1.75" />
                    <path d="M11.25 7.5H13M16.5 12.75V11M15 6l3 3M18 6l-3 3" />
                  </>
                )}
              </svg>
            </div>
            <div>
              <h3 class="text-balance font-display text-xl font-semibold leading-snug tracking-tight text-navy-900">
                {problem.title}
              </h3>
              {problem.description && (
                <p class="mt-3 text-base leading-relaxed text-slate-blue-600">
                  {problem.description}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
