---
// Section 3: Our Services
// The label, heading, service names, descriptions, examples and the closing message
// are wording the client supplied or approved. Do not reword without asking.
const services = [
  {
    icon: 'chat',
    title: 'AI Customer Support',
    description: 'Answers common customer questions at any hour and hands the rest to your team.',
    examples: [
      'Replies to frequent questions',
      'Order and booking updates',
      'Handover to your team when needed',
    ],
  },
  {
    icon: 'clipboard',
    title: 'Administrative Automation',
    description:
      'Handles routine paperwork, from data entry to reminders, so nobody has to copy and paste.',
    examples: [
      'Invoice and receipt processing',
      'Data entry between systems',
      'Appointment and payment reminders',
    ],
  },
  {
    icon: 'trend',
    title: 'Sales & Lead Automation',
    description:
      'Replies to new leads quickly and keeps follow-ups going, so fewer opportunities slip away.',
    examples: [
      'Fast first replies to new leads',
      'Automatic follow-up messages',
      'Quote requests logged and tracked',
    ],
  },
  {
    icon: 'sparkles',
    title: 'AI Business Assistants',
    description:
      'Gives your team an AI assistant that knows your business, ready to find answers and draft documents.',
    examples: [
      'Answers from your own documents',
      'First drafts of emails and reports',
      'Summaries of meetings and documents',
    ],
  },
  {
    icon: 'flow',
    title: 'Workflow Automation',
    description:
      'Connects the tools you already use, so information moves between them without retyping.',
    examples: [
      'Forms that update your spreadsheets',
      'Tasks created from incoming emails',
      'Approvals sent to the right person',
    ],
  },
  {
    icon: 'chip',
    title: 'Custom AI Solutions',
    description:
      'Purpose-built AI solutions designed around your unique business challenges, from intelligent agents to complex operational systems.',
    examples: [
      'Custom AI agents and applications',
      'Intelligent data analysis and decision support',
      'Advanced system and API integrations',
      'End-to-end business process automation',
    ],
  },
];
---

<section id="services" aria-labelledby="services-heading" class="bg-navy-900 text-offwhite">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <div data-reveal>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-400">Our Services</p>
      <h2
        id="services-heading"
        class="mt-5 max-w-4xl text-balance font-display text-4xl font-semibold leading-[1.1] tracking-tight text-offwhite sm:text-5xl lg:text-6xl"
      >
        Intelligent automation for <span class="text-teal-400">modern businesses</span>
      </h2>
    </div>

    {/*
      Six service cards, then the "something else" message as a strip across the full
      width. One column on phones, two from 768px, three from 1024px. Each service card
      is a subgrid spanning four
      rows (icon, name, description, examples) so those parts line up across a row
      even when one card's text wraps onto more lines than its neighbour's.
    */}
    <ul role="list" class="mt-16 grid gap-6 md:grid-cols-2 lg:mt-20 lg:grid-cols-3 lg:gap-8">
      {
        services.map((service, index) => (
          <li
            data-reveal
            style={`--reveal-delay: ${(index % 3) * 100}ms`}
            class="row-span-4 grid grid-rows-subgrid gap-y-0 rounded-2xl border border-slate-blue-500/25 bg-navy-800/60 p-8"
          >
            <div
              aria-hidden="true"
              class="flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-400/10 text-teal-400"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-7 w-7"
              >
                {service.icon === 'chat' && (
                  <>
                    <path d="M4.75 6.75a2 2 0 0 1 2-2h10.5a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H11l-4.25 3v-3a2 2 0 0 1-2-2z" />
                    <path d="M8.75 11h.01M12 11h.01M15.25 11h.01" stroke-width="2" />
                  </>
                )}
                {service.icon === 'clipboard' && (
                  <>
                    <path d="M9 5.25H7.75a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h8.5a2 2 0 0 0 2-2v-11a2 2 0 0 0-2-2H15" />
                    <rect x="9" y="3.75" width="6" height="3" rx="1" />
                    <path d="M9 13.25l2.25 2.25 3.75-4.5" />
                  </>
                )}
                {service.icon === 'trend' && (
                  <>
                    <path d="M3.75 16.75l5.5-5.5 3.5 3.5 7.5-7.5" />
                    <path d="M15.25 7.25h5v5" />
                  </>
                )}
                {service.icon === 'sparkles' && (
                  <>
                    <path d="M10.5 5.75c.6 3.4 2.35 5.15 5.75 5.75-3.4.6-5.15 2.35-5.75 5.75-.6-3.4-2.35-5.15-5.75-5.75 3.4-.6 5.15-2.35 5.75-5.75z" />
                    <path d="M18 3.75c.2 1.3.95 2.05 2.25 2.25-1.3.2-2.05.95-2.25 2.25-.2-1.3-.95-2.05-2.25-2.25 1.3-.2 2.05-.95 2.25-2.25z" />
                  </>
                )}
                {service.icon === 'flow' && (
                  <>
                    <rect x="3.75" y="9" width="6" height="6" rx="1.5" />
                    <rect x="14.25" y="3.75" width="6" height="6" rx="1.5" />
                    <rect x="14.25" y="14.25" width="6" height="6" rx="1.5" />
                    <path d="M9.75 12H12M14.25 6.75H13a1 1 0 0 0-1 1v8.5a1 1 0 0 0 1 1h1.25" />
                  </>
                )}
                {service.icon === 'chip' && (
                  <>
                    <rect x="7" y="7" width="10" height="10" rx="2" />
                    <rect x="10.25" y="10.25" width="3.5" height="3.5" rx="0.75" />
                    <path d="M9.75 4.25V7M14.25 4.25V7M9.75 17v2.75M14.25 17v2.75M4.25 9.75H7M4.25 14.25H7M17 9.75h2.75M17 14.25h2.75" />
                  </>
                )}
              </svg>
            </div>
            <h3 class="mt-6 font-display text-xl font-semibold leading-snug tracking-tight text-offwhite">
              {service.title}
            </h3>
            <p class="mt-3 text-base leading-relaxed text-slate-blue-300">{service.description}</p>
            <ul role="list" class="mt-6 space-y-3 border-t border-slate-blue-500/25 pt-6">
              {service.examples.map((example) => (
                <li class="flex gap-3 text-sm leading-6 text-offwhite">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="mt-0.5 h-5 w-5 shrink-0 text-teal-400"
                  >
                    <path d="M5 10.5l3.25 3.25L15 6.75" />
                  </svg>
                  <span>{example}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }

      {/* The client's closing message, across the full width, linking to the contact section. */}
      <li data-reveal class="md:col-span-2 lg:col-span-3">
        <a
          href="#contact"
          class="group flex items-center justify-between gap-6 rounded-2xl border border-dashed border-teal-400/50 p-8 transition-colors hover:border-teal-400 hover:bg-teal-400/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-400"
        >
          <span class="block">
            <span class="block text-balance font-display text-2xl font-semibold leading-snug tracking-tight text-offwhite">Have something else in mind?</span>{' '}
            <span class="mt-2 block text-base leading-relaxed text-slate-blue-300">We build custom AI solutions too.</span>
          </span>
          <span
            aria-hidden="true"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-teal-400/60 text-teal-400 transition-transform group-hover:translate-x-1"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d="M5.75 12h12.5M13.25 7l5 5-5 5" />
            </svg>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>
