---
// Section 7: Let's Talk (final call to action)
// The label, headline, intro, the two option names, the email address and the
// thank-you text are the client's wording or choices. Do not reword without asking.

// The two services this section talks to. Change them here only.
const calendlyUrl = 'https://calendly.com/kavalirlabs/meeting-30-minutes';
const formspreeEndpoint = 'https://formspree.io/f/xyewwykj';
const email = 'info@kavalirlabs.com';

const labelClass = 'block text-sm font-medium text-offwhite';
const fieldClass =
  'mt-2 block w-full rounded-xl border border-slate-blue-400/80 bg-navy-900/70 px-4 py-3 text-base text-offwhite transition-colors focus:border-teal-400 focus:outline-2 focus:outline-offset-2 focus:outline-teal-400 aria-[invalid=true]:border-red-300';
// Shown by the Formspree script, which adds data-fs-active when there is an error.
const fieldErrorClass = 'mt-2 hidden text-sm text-red-300 data-[fs-active]:block';
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="relative isolate overflow-clip bg-navy-900 text-offwhite"
>
  {/* Decorative glows, echoing the hero */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute -bottom-48 left-1/2 h-[520px] w-[900px] max-w-none -translate-x-1/2 rounded-full bg-teal-500/15 blur-[140px]"
    >
    </div>
    <div class="absolute -left-40 -top-40 h-[420px] w-[420px] rounded-full bg-slate-blue-500/20 blur-[140px]">
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32 lg:grid lg:grid-cols-2 lg:gap-16">
    {/* Left: headline, intro, booking link and email address */}
    <div data-reveal>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-teal-400">Let's Talk</p>
      <h2
        id="contact-heading"
        class="mt-5 text-balance font-display text-4xl font-semibold leading-[1.1] tracking-tight text-offwhite sm:text-5xl lg:text-6xl"
      >
        Ready to <span class="text-teal-400">work smarter?</span>
      </h2>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-slate-blue-300">
        Tell us what's slowing your business down. We'll explore how automation could help.
      </p>

      <div class="mt-10">
        <a
          href={calendlyUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center gap-3 whitespace-nowrap rounded-full bg-teal-400 px-5 py-4 text-base font-semibold text-navy-950 transition hover:bg-teal-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-300 sm:w-auto sm:px-8"
        >
          Book a Free Consultation
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
          >
            <path d="M8.25 15.75l7.5-7.5M9.75 8.25h6v6" />
          </svg>
          <span class="sr-only">(opens Calendly in a new tab)</span>
        </a>
      </div>

      <p class="mt-6 text-base text-slate-blue-300">
        Or email <a
          href={`mailto:${email}`}
          class="font-medium text-offwhite underline decoration-teal-400 decoration-2 underline-offset-4 transition-colors hover:text-teal-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-400"
          >{email}</a
        >
      </p>
    </div>

    {/* Right: the message form */}
    <div
      data-reveal
      style="--reveal-delay: 100ms"
      class="mt-14 rounded-2xl border border-slate-blue-500/25 bg-navy-800/60 p-8 lg:mt-0 xl:p-10"
    >
      <h3 class="font-display text-2xl font-semibold leading-snug tracking-tight text-offwhite">
        Send Us a Message
      </h3>

      {/*
        Works without JavaScript: the form posts straight to Formspree, which then shows
        its own confirmation page. With JavaScript, the script below sends it in the
        background and shows the thank-you message here instead.
      */}
      <form id="contact-form" action={formspreeEndpoint} method="POST" class="mt-8 space-y-6">
        <p
          data-fs-error=""
          role="alert"
          tabindex="-1"
          class="hidden rounded-xl border border-red-300/40 bg-red-400/10 px-4 py-3 text-sm leading-relaxed text-red-200 focus:outline-none data-[fs-active]:block"
        >
          Sorry, your message could not be sent. Please try again, or email {email}.
        </p>

        <div>
          <label for="contact-name" class={labelClass}>Name</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            required
            data-fs-field
            aria-describedby="contact-name-error"
            class={fieldClass}
          />
          <p id="contact-name-error" data-fs-error="name" class={fieldErrorClass}></p>
        </div>

        <div>
          <label for="contact-email" class={labelClass}>Email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            data-fs-field
            aria-describedby="contact-email-error"
            class={fieldClass}
          />
          <p id="contact-email-error" data-fs-error="email" class={fieldErrorClass}></p>
        </div>

        <div>
          <label for="contact-message" class={labelClass}>Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="5"
            required
            data-fs-field
            aria-describedby="contact-message-error"
            class={fieldClass}></textarea>
          <p id="contact-message-error" data-fs-error="message" class={fieldErrorClass}></p>
        </div>

        {/* Spam trap: hidden from people, so only bots fill it in. Formspree discards those. */}
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
        <input type="hidden" name="_subject" value="New message from kavalirlabs.com" />

        <button
          type="submit"
          data-fs-submit-btn
          class="w-full rounded-full bg-teal-400 px-8 py-4 text-base font-semibold text-navy-950 transition hover:bg-teal-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-300 disabled:cursor-wait disabled:opacity-60 sm:w-auto"
        >
          Send Message
        </button>

        <p class="text-sm leading-relaxed text-slate-blue-300">
          We only use your details to reply to you. Read our <a
            href="/privacy/"
            class="font-medium text-offwhite underline decoration-teal-400 underline-offset-4 transition-colors hover:text-teal-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-400"
            >Privacy Policy</a
          >.
        </p>
      </form>

      {/* Replaces the form once the message has been sent. */}
      <div
        id="contact-success"
        data-fs-success
        tabindex="-1"
        class="mt-8 hidden rounded-xl border border-teal-400/40 bg-teal-400/10 p-6 focus:outline-none data-[fs-active]:block"
      >
        <p>
          <span class="block font-display text-xl font-semibold text-offwhite">Thank you.</span>{' '}
          <span class="mt-2 block text-base leading-relaxed text-slate-blue-300">Your message has been sent and we will reply as soon as we can.</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Formspree's own library (the "Vanilla JS, with a bundler" setup from their guide).
  import { initForm } from '@formspree/ajax';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  if (form) {
    // When sending fails, move focus to the first field Formspree rejected, or to the
    // general error message, so keyboard and screen reader users are told what happened.
    // (The library disables the Send button while sending, which drops focus otherwise.)
    const focusError = (context: { form: HTMLFormElement }) => {
      const target =
        context.form.querySelector<HTMLElement>('[aria-invalid="true"]') ??
        context.form.querySelector<HTMLElement>('[data-fs-error=""]');
      target?.focus();
    };

    initForm({
      formElement: form,
      // The form id is the last part of the endpoint in the form's action attribute.
      formId: new URL(form.action).pathname.split('/').filter(Boolean).pop() ?? '',
      // The page styles the messages itself (see the data-[fs-active] classes above).
      useDefaultStyles: false,
      onSuccess: (context) => {
        context.form.hidden = true;
        document.querySelector<HTMLElement>('#contact-success')?.focus();
      },
      onError: focusError,
      onFailure: focusError,
    });
  }
</script>
