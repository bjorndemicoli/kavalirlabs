---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// The two font files every page uses, preloaded so text renders in its final font sooner.
import groteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results (used by the 404 page). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';

// Image shown when the link is shared (public/og-image.png, 1200 x 630).
const shareImage = new URL('/og-image.png', Astro.site);
const shareImageAlt = 'Kavalir Labs. Less manual work. More time for your business.';

// Structured data about the business, on the home page only.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Kavalir Labs',
  url: 'https://kavalirlabs.com/',
  email: 'info@kavalirlabs.com',
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {/* crossorigin is required on font preloads, or the browser downloads the font twice. */}
    <link rel="preload" as="font" type="font/woff2" href={groteskLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b1626" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kavalir Labs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(organization)} />}

    {/*
      Scroll reveal for elements marked data-reveal (styles in global.css).
      Runs inline in the head so the hidden state is set before first paint.
      If anything fails, .reveal-on is removed and all content stays visible.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;

        // Header: see-through while the page is at the very top (styles in global.css).
        var updateHeader = function () {
          root.classList.toggle('header-at-top', window.scrollY < 8);
        };
        updateHeader();
        window.addEventListener('scroll', updateHeader, { passive: true });
        window.addEventListener('pageshow', updateHeader);

        // Scroll reveal.
        if (
          !('IntersectionObserver' in window) ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          return;
        }
        root.classList.add('reveal-on');
        document.addEventListener('DOMContentLoaded', function () {
          try {
            var observer = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                  }
                });
              },
              { rootMargin: '0px 0px -8% 0px', threshold: 0.15 }
            );
            document.querySelectorAll('[data-reveal]').forEach(function (el) {
              observer.observe(el);
            });
          } catch (error) {
            root.classList.remove('reveal-on');
          }
        });
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-teal-400 focus:px-4 focus:py-2 focus:text-navy-950"
    >
      Skip to content
    </a>
    {/* The header sits on top of the first block of each page, which must be dark. */}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
